<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClashMimo.Desktop.Controls"
             xmlns:loc="using:ClashMimo.Desktop.Localization"
             xmlns:vm="using:ClashMimo.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="ClashMimo.Desktop.Views.Settings.SettingsCoreLogView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
<!-- 内核日志 -->
<StackPanel Spacing="10" IsVisible="{Binding Settings.IsCoreLogVisible}">
  <TextBlock Classes="surface-group-title" Text="{Binding Settings.HeaderText}" />
  <Border Classes="surface-group">
    <Border Classes="settings-inline-row">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="settings-row-title" Text="{Binding CoreConfig.CoreLogLevelText}" />
        <ComboBox Grid.Column="1"
                  AutomationProperties.AutomationId="Settings.CoreLogLevelComboBox"
                  MinWidth="160"
                  ItemsSource="{Binding CoreConfig.CoreLogLevelOptions}"
                  SelectedItem="{Binding CoreConfig.SelectedCoreLogLevelOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ISelectionOption">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>
  </Border>
</StackPanel>
</UserControl>
